# Copy into Dokploy's Environment tab. Do not commit a filled-in .env.
# Passwords used in Redis URLs must match [A-Za-z0-9]. Other secrets may too.

APP_NAME=Git

# Apex example.com → web git.example.com, SSH ssh.example.com
GIT_DOMAIN=git.example.com
SSH_DOMAIN=ssh.example.com

# Comma-separated. Add the dokploy-network subnet from
# `docker network inspect dokploy-network`.
TRUSTED_PROXIES=127.0.0.0/8,::1/128

POSTGRES_USER=forgejo
POSTGRES_PASSWORD=replace-with-alphanumeric
POSTGRES_DB=forgejo

REDIS_PASSWORD=replace-with-alphanumeric

# Generate each with the Forgejo image, once, and keep them forever:
#   docker run --rm codeberg.org/forgejo/forgejo:15-rootless \
#     forgejo generate secret SECRET_KEY
# Repeat for INTERNAL_TOKEN, LFS_JWT_SECRET, and JWT_SECRET.
SECRET_KEY=
INTERNAL_TOKEN=
LFS_JWT_SECRET=
OAUTH2_JWT_SECRET=

# Host only, no scheme and no path. Create the bucket first.
# Checksum: default for AWS, MinIO, and Garage. md5 for Cloudflare R2 and Backblaze B2.
S3_ENDPOINT=s3.amazonaws.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=forgejo
S3_LOCATION=us-east-1
S3_CHECKSUM_ALGORITHM=default

# smtp+starttls on 587, or smtps on 465.
MAIL_PROTOCOL=smtp+starttls
MAIL_SMTP_ADDR=smtp.example.com
MAIL_SMTP_PORT=587
MAIL_USER=git@example.com
MAIL_PASSWORD=
MAIL_FROM="Git <git@example.com>"

# Local break-glass admin. Day-to-day login is OIDC.
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# Redirect URI to register at the IdP:
#   https://git.example.com/user/oauth2/oidc/callback
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_DISCOVERY_URL=https://auth.example.com/application/o/forgejo/.well-known/openid-configuration
OIDC_GROUPS_SCOPE=groups
OIDC_REQUIRED_CLAIM=groups
OIDC_REQUIRED_VALUE=forgejo-users
OIDC_ADMIN_GROUP=forgejo-admins

# 40 hex characters. openssl rand -hex 20
# A token from the Forgejo UI is not a substitute.
RUNNER_SECRET=
